# Chemins relatifs au dossier web/ si les variables sont utilisées localement.
LOTIMAP_GEOJSON_PATH=../data/demo/geojson/clos_du_verger.geojson
LOTIMAP_DB_PATH=.data/lotimap.sqlite
LOTIMAP_ENRICHMENT_PATH=../data/demo/enrichment.json

# Décommenter pour activer /admin. Garder web/.env hors de Git.
# LOTIMAP_ADMIN_PASSWORD=
# LOTIMAP_SESSION_SECRET=
# Origine publique exacte à définir derrière un proxy HTTPS.
# LOTIMAP_PUBLIC_ORIGIN=https://votre-domaine.example
