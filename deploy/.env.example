# Copier dans deploy/.env (ignoré par Git). Ne pas y mettre de valeurs publiques réelles dans Git.
LOTIMAP_LOCAL_PORT=3333

# Laisser vides pour désactiver l'administration.
LOTIMAP_ADMIN_PASSWORD=
LOTIMAP_SESSION_SECRET=

# Configuration de votre Traefik existant, uniquement pour le VPS.
LOTIMAP_DOMAIN=lotimap.example
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
